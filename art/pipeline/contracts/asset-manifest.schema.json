{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komorebi.house/contracts/asset-manifest.schema.json",
  "title": "Komorebi House original-room restyle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sliceId", "runtime", "geometryLock", "references", "cutover", "assets", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sliceId": { "const": "vertical-slice-01" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "simulationCanvas", "renderCanvas", "worldTile", "placementGrid", "geometrySourceCommit"],
      "properties": {
        "engine": { "const": "phaser-3.90.0" },
        "simulationCanvas": { "const": [480, 270] },
        "renderCanvas": { "const": [960, 540] },
        "worldTile": { "const": [16, 16] },
        "placementGrid": { "const": [8, 8] },
        "geometrySourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "geometryLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "room"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/hashedFile" }
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bounds", "placementArea", "spawns", "portals", "interactions"],
          "properties": {
            "bounds": { "const": [0, 0, 480, 270] },
            "placementArea": { "const": [58, 104, 364, 124] },
            "spawns": { "const": [[240, 172], [240, 224], [104, 214]] },
            "portals": { "const": [[206, 232, 70, 38], [66, 224, 58, 46]] },
            "interactions": { "const": [[136, 112], [300, 102], [118, 82], [380, 108]] }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "role"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "enum": ["night-primary", "day-derived"] }
        }
      }
    },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalFurnitureLoader", "strictRequiredAssetFailure", "imageGenerationAuthorized", "newRuntimeFiles", "newRenderers", "newFeatureFlags", "newAtlases", "newMapSchemas", "newMigrationLayers", "newDuplicateAssetPaths", "maxNetRuntimeSourceLines"],
      "properties": {
        "externalFurnitureLoader": { "enum": ["absent-blocked", "strict-ready"] },
        "strictRequiredAssetFailure": { "enum": ["not-implemented-blocked", "implemented"] },
        "imageGenerationAuthorized": { "type": "boolean" },
        "newRuntimeFiles": { "const": 0 },
        "newRenderers": { "const": 0 },
        "newFeatureFlags": { "const": 0 },
        "newAtlases": { "const": 0 },
        "newMapSchemas": { "const": 0 },
        "newMigrationLayers": { "const": 0 },
        "newDuplicateAssetPaths": { "const": 0 },
        "maxNetRuntimeSourceLines": { "const": 0 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/asset" }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coldBoot", "placement", "occlusion", "saveReload", "mobileTouch", "nightPresentation", "visualReview", "visualScoreMinimum", "visualCategoryMinimum", "desktopCapture", "mobileCapture"],
      "properties": {
        "coldBoot": { "type": "boolean" },
        "placement": { "type": "boolean" },
        "occlusion": { "type": "boolean" },
        "saveReload": { "type": "boolean" },
        "mobileTouch": { "type": "boolean" },
        "nightPresentation": { "type": "boolean" },
        "visualReview": { "type": "boolean" },
        "visualScoreMinimum": { "const": 85 },
        "visualCategoryMinimum": { "const": 8 },
        "desktopCapture": { "const": [1280, 720, 1] },
        "mobileCapture": { "const": [390, 844, 2] }
      }
    }
  },
  "$defs": {
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbol", "scope"],
      "properties": {
        "file": { "type": "string" },
        "symbol": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "kind", "state", "runtimeKey", "nativeCanvas", "runtimeOrigin", "currentProducer", "replacementTarget", "currentFallbacks", "sameChangeDeletionTargets", "retainedBlockers", "proof"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "family": { "type": "string" },
        "kind": { "enum": ["architecture", "furniture"] },
        "state": { "enum": ["brief", "candidate", "normalized", "metadata-bound", "runtime-approved", "shipped"] },
        "revision": { "type": "string", "pattern": "^v[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtimeKey": { "type": "string", "pattern": "^koh:" },
        "nativeCanvas": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "runtimeOrigin": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "displayScale": { "type": "number", "exclusiveMinimum": 0 },
        "castMask": { "$ref": "#/$defs/mask" },
        "contactMask": { "$ref": "#/$defs/mask" },
        "footprint": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "starterPlacement": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "currentProducer": { "type": "string" },
        "replacementTarget": { "type": ["string", "null"] },
        "currentFallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } },
        "sameChangeDeletionTargets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "retainedBlockers": { "type": "array", "items": { "type": "string" } },
        "derivedRotationCels": {
          "type": "array",
          "items": { "$ref": "#/$defs/rotationCel" }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvedSourceSha256", "imageGenerationSha256", "cleanupInputSha256", "cleanupMaskSha256", "cleanupMethod", "changedPixelPercent"],
          "properties": {
            "approvedSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "imageGenerationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "cleanupInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "cleanupMaskSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "cleanupMethod": { "type": "string" },
            "changedPixelPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["juryDecision", "juryScore", "juryCategoryMinimum", "runtimeIntegration", "runtimeAssetSha256", "desktopCaptures", "nativeCaptures"],
          "properties": {
            "juryDecision": { "const": "pass" },
            "juryScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "juryCategoryMinimum": { "type": "number", "minimum": 0, "maximum": 10 },
            "runtimeIntegration": { "type": "boolean" },
            "runtimeAssetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "desktopCaptures": {
              "type": "array",
              "minItems": 6,
              "items": { "$ref": "#/$defs/captureReceipt" }
            },
            "nativeCaptures": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/captureReceipt" }
            }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isolated", "anchor", "footprint", "runtimeCapture", "oldProducerDeleted"],
          "properties": {
            "isolated": { "type": "boolean" },
            "anchor": { "type": "boolean" },
            "footprint": { "type": "boolean" },
            "runtimeCapture": { "type": "boolean" },
            "oldProducerDeleted": { "type": "boolean" }
          }
        }
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "alphaLevels"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "alphaLevels": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "uniqueItems": true }
      }
    },
    "rotationCel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation", "runtimeKey", "replacementTarget", "nativeCanvas"],
      "properties": {
        "rotation": { "enum": [90, 180, 270] },
        "runtimeKey": { "type": "string", "pattern": "^koh:" },
        "replacementTarget": { "type": "string" },
        "nativeCanvas": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "castMask": { "$ref": "#/$defs/mask" },
        "contactMask": { "$ref": "#/$defs/mask" }
      }
    },
    "captureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "state", "sha256"],
      "properties": {
        "viewport": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
        "state": { "enum": ["sparse", "furnished"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
